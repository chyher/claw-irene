<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daily AI News | Irene 技能展示</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/shared.css">
  <link rel="stylesheet" href="../css/animations.css">
  <link rel="stylesheet" href="../css/components/skill-detail.css">
  <link rel="stylesheet" href="../css/components/demo-area.css">
  <link rel="stylesheet" href="../css/components/irene-mood.css">
  <style>
    .news-demo { --news-accent: #f59e0b; --news-accent-glow: 0 0 20px rgba(245, 158, 11, 0.4); }
    .news-categories { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-bottom: var(--space-lg); padding-bottom: var(--space-md); border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .news-category { padding: var(--space-xs) var(--space-md); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; font-size: 13px; color: var(--text-secondary); cursor: pointer; transition: all 0.3s ease; }
    .news-category:hover { background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.3); color: var(--news-accent); }
    .news-category.active { background: rgba(245, 158, 11, 0.2); border-color: var(--news-accent); color: var(--news-accent); box-shadow: var(--news-accent-glow); }
    .news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-lg); }
    .news-card { background: var(--bg-card); border-radius: var(--border-radius); border: 1px solid rgba(255, 255, 255, 0.05); padding: var(--space-lg); cursor: pointer; transition: all 0.4s var(--ease-out-expo); position: relative; overflow: hidden; }
    .news-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--news-accent), transparent); opacity: 0; transition: opacity 0.3s ease; }
    .news-card:hover { transform: translateY(-5px); border-color: rgba(245, 158, 11, 0.3); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), var(--news-accent-glow); }
    .news-card:hover::before { opacity: 1; }
    .news-card.hidden { display: none; }
    .news-card__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-md); }
    .news-card__source { display: flex; align-items: center; gap: var(--space-sm); font-size: 13px; color: var(--text-secondary); }
    .news-card__source-icon { width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 14px; background: rgba(245, 158, 11, 0.15); }
    .news-card__hot { display: flex; align-items: center; gap: 4px; padding: 2px 8px; background: rgba(255, 107, 107, 0.15); border-radius: 12px; font-size: 11px; color: var(--accent-orange); animation: pulseHot 2s ease-in-out infinite; }
    @keyframes pulseHot { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
    .news-card__title { font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-sm); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .news-card__summary { font-size: 13px; color: var(--text-secondary); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: var(--space-md); }
    .news-card__footer { display: flex; align-items: center; justify-content: space-between; }
    .news-card__time { font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 4px; }
    .news-card__category { padding: 2px 10px; background: rgba(0, 245, 255, 0.1); border-radius: 12px; font-size: 11px; color: var(--accent-cyan); }
    .news-card__category--model { background: rgba(168, 85, 247, 0.15); color: var(--accent-purple); }
    .news-card__category--product { background: rgba(34, 197, 94, 0.15); color: var(--accent-green); }
    .news-card__category--research { background: rgba(14, 165, 233, 0.15); color: var(--accent-blue); }
    .news-card__category--industry { background: rgba(245, 158, 11, 0.15); color: var(--news-accent); }
    .news-skeleton { background: var(--bg-card); border-radius: var(--border-radius); border: 1px solid rgba(255, 255, 255, 0.05); padding: var(--space-lg); animation: skeletonPulse 1.5s ease-in-out infinite; }
    .news-skeleton__header { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-md); }
    .news-skeleton__icon { width: 24px; height: 24px; border-radius: 6px; background: rgba(255, 255, 255, 0.05); }
    .news-skeleton__text { height: 14px; width: 80px; border-radius: 4px; background: rgba(255, 255, 255, 0.05); }
    .news-skeleton__title { height: 20px; border-radius: 4px; background: rgba(255, 255, 255, 0.08); margin-bottom: var(--space-sm); }
    .news-skeleton__summary { height: 14px; border-radius: 4px; background: rgba(255, 255, 255, 0.05); margin-bottom: var(--space-xs); }
    .news-skeleton__footer { display: flex; justify-content: space-between; margin-top: var(--space-md); }
    .news-skeleton__badge { height: 12px; width: 60px; border-radius: 4px; background: rgba(255, 255, 255, 0.05); }
    @keyframes skeletonPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    .news-modal { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(10px); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: var(--space-lg); opacity: 0; visibility: hidden; transition: all 0.3s ease; }
    .news-modal.active { opacity: 1; visibility: visible; }
    .news-modal__content { background: var(--bg-secondary); border-radius: var(--border-radius-lg); border: 1px solid rgba(245, 158, 11, 0.2); max-width: 600px; width: 100%; max-height: 80vh; overflow-y: auto; position: relative; transform: scale(0.9); transition: transform 0.3s ease; }
    .news-modal.active .news-modal__content { transform: scale(1); }
    .news-modal__close { position: absolute; top: var(--space-md); right: var(--space-md); width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); border: none; color: var(--text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; }
    .news-modal__close:hover { background: rgba(255, 107, 107, 0.2); color: var(--accent-orange); }
    .news-modal__body { padding: var(--space-xl); }
    .news-modal__source { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-md); }
    .news-modal__source-icon { width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 20px; background: rgba(245, 158, 11, 0.15); }
    .news-modal__source-info { flex: 1; }
    .news-modal__source-name { font-size: 14px; font-weight: 500; color: var(--text-primary); }
    .news-modal__source-time { font-size: 12px; color: var(--text-muted); }
    .news-modal__title { font-size: 22px; font-weight: 700; color: var(--text-primary); margin-bottom: var(--space-md); line-height: 1.4; }
    .news-modal__summary { font-size: 15px; color: var(--text-secondary); line-height: 1.8; margin-bottom: var(--space-lg); }
    .news-modal__meta { display: flex; gap: var(--space-md); padding-top: var(--space-lg); border-top: 1px solid rgba(255, 255, 255, 0.05); }
    .news-modal__meta-item { display: flex; align-items: center; gap: var(--space-xs); font-size: 13px; color: var(--text-muted); }
    .news-refresh { display:
